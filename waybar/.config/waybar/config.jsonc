{
  "layer": "top",
  "position": "top",
  "height": 30,

  "modules-left": [
    "hyprland/workspaces"
  ],

  "modules-center": [
    "hyprland/window"
  ],

  "modules-right": [
    "network",
    "pulseaudio",
    "battery",
    "clock",
    "tray"
  ],

  "hyprland/workspaces": {
    "format": "{name}"
  },

  "hyprland/window": {
    "max-length": 50
  },

  "network": {
    "format-wifi": "{essid} {signalStrength}%",
    "format-ethernet": "ETH",
    "format-disconnected": "offline"
  },

  "pulseaudio": {
    "format": "VOL {volume}%"
  },


  "battery": {
    "format": "{capacity}% {icon}",
    "format-charging": "{capacity}% ⚡",
    "format-plugged": "{capacity}% ",
    "format-alt": "{time} {icon}",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
},

  "clock": {
    "format": "{:%I:%M}"
  }
}
