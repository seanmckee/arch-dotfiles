# @@name@@ -- GENERATED by `theme`; edit themes/templates/mako.config instead
font=JetBrainsMono Nerd Font 11
background-color=@@bg@@@@bg_alpha@@
text-color=@@fg@@
border-color=@@accent2@@
progress-color=over @@sel@@

width=380
height=140
margin=10
padding=14
border-size=2
border-radius=10
max-icon-size=48

default-timeout=6000
ignore-timeout=0
layer=overlay
anchor=top-right

[urgency=low]
border-color=@@muted@@
text-color=@@dim@@
default-timeout=4000

[urgency=normal]
border-color=@@accent2@@

[urgency=critical]
border-color=@@red@@
text-color=@@red@@
default-timeout=0
